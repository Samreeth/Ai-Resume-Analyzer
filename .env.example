# Root environment configuration template
# Copy this file to .env and adjust values as needed. Never commit actual .env files containing secrets.

NODE_ENV=development

# Backend Server
PORT=5000
SERVER_URL=http://localhost:5000

# Client Frontend
CLIENT_PORT=5173
CLIENT_URL=http://localhost:5173

# Python NLP Service
NLP_PORT=8000
NLP_SERVICE_URL=http://localhost:8000
NLP_SERVICE_TOKEN=replace_with_internal_service_token

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/resume_analyzer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=resume_analyzer
POSTGRES_PORT=5432

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Google Gemini API (Optional AI Layer)
# Disabled by default. Set GEMINI_ENABLED=true and supply a valid API key to enable.
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=10000
