@@ -0,0 +1,169 @@
+/**
+ * Evidence Grounding Verification Utility
+ *
+ * Verifies that factual claims extracted by Gemini are substantiated by
+ * verbatim evidence snippets present in the original extracted resume text.
+ *
+ * Checks:
+ * 1. Evidence Existence: Snippet must be a true substring in the source resume.
+ * 2. Relevance / Entity Substantiation: Snippet must contain key entity tokens (e.g. company, skill, school).
+ * Claims failing these checks are explicitly labeled as UNVERIFIED.
+ */
+
+/**
+ * Normalize whitespace and casing for robust text comparison.
+ *
+ * @param {string} str
+ * @returns {string}
+ */
+const normalizeText = (str) => {
+  return String(str || '')
+    .toLowerCase()
+    .replace(/[\r\n\t]+/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim();
+};
+
+/**
+ * Check if an evidence snippet is grounded in source text and supports the claim.
+ *
+ * @param {string} snippet - Extracted evidence quote
+ * @param {string} normalizedSource - Pre-normalized source resume text
+ * @param {string[]} [keyTokens=[]] - Identifying tokens that must appear in the snippet
+ * @returns {{ verified: boolean, reason: string | null }}
+ */
+export const verifySnippet = (snippet, normalizedSource, keyTokens = []) => {
+  if (!snippet || typeof snippet !== 'string' || snippet.trim().length < 3) {
+    return {
+      verified: false,
+      reason: 'Missing or insufficient evidence snippet',
+    };
+  }
+
+  const normalizedSnippet = normalizeText(snippet);
+  const normSource = normalizeText(normalizedSource);
+
+  // Check 1: Existence in source text
+  if (!normSource.includes(normalizedSnippet)) {
+    return {
+      verified: false,
+      reason: 'Evidence snippet not found in candidate resume text',
+    };
+  }
+
+  // Check 2: Relevance to claim
+  // At least one key identifying token from the claim must appear in the evidence snippet
+  const validTokens = keyTokens
+    .filter((t) => t && typeof t === 'string' && t.trim().length >= 2)
+    .map((t) => normalizeText(t));
+
+  if (validTokens.length > 0) {
+    const hasToken = validTokens.some((token) => normalizedSnippet.includes(token));
+    if (!hasToken) {
+      return {
+        verified: false,
+        reason: 'Evidence snippet does not substantiate the claimed entity or skill',
+      };
+    }
+  }
+
+  return { verified: true, reason: null };
+};
+
+/**
+ * Perform evidence grounding verification across all sections of an AI-generated resume profile.
+ *
+ * @param {object} profile - Validated resume profile object
+ * @param {string} originalResumeText - Raw original extracted resume text
+ * @returns {object} Grounded profile with verification_status and unverified_reason populated
+ */
+export const verifyProfileGrounding = (profile, originalResumeText) => {
+  if (!profile || typeof profile !== 'object') return profile;
+
+  const normalizedSource = normalizeText(originalResumeText);
+  const ungroundedClaims = [];
+
+  const processSection = (items, getTokens, sectionName) => {
+    if (!Array.isArray(items)) return [];
+
+    return items.map((item) => {
+      const tokens = getTokens(item);
+      const { verified, reason } = verifySnippet(item.evidence_snippet, normalizedSource, tokens);
+
+      const status = verified ? 'VERIFIED' : 'UNVERIFIED';
+      const unverifiedReason = verified ? null : reason;
+
+      if (!verified) {
+        ungroundedClaims.push({
+          section: sectionName,
+          text_snippet: String(item.evidence_snippet || '').slice(0, 400),
+          ambiguity_reason: `Unverified claim (${tokens.join(', ') || 'item'}): ${reason}`,
+        });
+      }
+
+      return {
+        ...item,
+        verification_status: status,
+        unverified_reason: unverifiedReason,
+      };
+    });
+  };
+
+  const technical_skills = processSection(
+    profile.technical_skills,
+    (s) => [s.name],
+    'Technical Skills'
+  );
+
+  const soft_skills = processSection(
+    profile.soft_skills,
+    (s) => [s.name],
+    'Soft Skills'
+  );
+
+  const education = processSection(
+    profile.education,
+    (e) => [e.institution, e.degree, e.field_of_study].filter(Boolean),
+    'Education'
+  );
+
+  const work_experience = processSection(
+    profile.work_experience,
+    (w) => [w.organization, w.role].filter(Boolean),
+    'Work Experience'
+  );
+
+  const projects = processSection(
+    profile.projects,
+    (p) => [p.name],
+    'Projects'
+  );
+
+  const certifications_and_achievements = processSection(
+    profile.certifications_and_achievements,
+    (c) => [c.title, c.issuer].filter(Boolean),
+    'Certifications & Achievements'
+  );
+
+  // Combine original ambiguous items with newly detected ungrounded claims
+  const ambiguous_or_unclear_items = [
+    ...(Array.isArray(profile.ambiguous_or_unclear_items) ? profile.ambiguous_or_unclear_items : []),
+    ...ungroundedClaims,
+  ];
+
+  return {
+    professional_summary: profile.professional_summary || null,
+    technical_skills,
+    soft_skills,
+    education,
+    work_experience,
+    projects,
+    certifications_and_achievements,
+    ambiguous_or_unclear_items,
+  };
+};
+
+export default {
+  verifySnippet,
+  verifyProfileGrounding,
+};
